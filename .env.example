# ============ AIライブショップ 環境設定 ============
# このファイルを .env にコピーして値を書き換えてください

# --- データベース(開発は MySQL。先に docker compose up -d db で起動しておく) ---
DATABASE_URL=mysql+aiomysql://liveuser:livepass@127.0.0.1:3306/livecommerce?charset=utf8mb4
# Docker を使わずに試すだけなら SQLite(ファイル1つで動く):
# DATABASE_URL=sqlite+aiosqlite:///./live.db

# --- AI ホストの LLM。キーが空ならルール応答で動く(LLMなしでも動作) ---
# LLM_PROVIDER: auto(キーがある方。両方あれば Anthropic)/ anthropic / openai / none
LLM_PROVIDER=auto
# OpenAI(または互換 API)。コメントBOTのコメント生成にも同じキーを使う
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic(Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
HOST_NAME=ハナ
REPLY_MIN_INTERVAL=4.0     # AI回答の最小間隔(秒) API費用と読み上げテンポの調整用
CHAT_REPLY_PROB=0.3        # 雑談コメントに反応する確率(質問は必ず回答)
IDLE_INTERVAL=45.0         # 無人時の自動トーク間隔(秒)

# --- VOICEVOX(Windowsデスクトップ機で起動する場合はそのIPに変更) ---
TTS_PROVIDER=voicevox      # voicevox / none(音声なし・文字のみ)
VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX_URL=http://192.168.x.x:50021   # 別マシンのVOICEVOXを使う場合
VOICEVOX_SPEAKER=3         # 3=ずんだもん(ノーマル) ※感情によって自動で1(あまあま)等に切替
VOICEVOX_SPEED=1.05

# --- 管理コンソール(/admin)---
ADMIN_TOKEN=change-me-admin-token

# --- セキュリティ(通常は変更不要)---
# PASSWORD_ITERATIONS=600000   # PBKDF2 の繰り返し回数。上げると既存ユーザーは次回ログイン時に自動で更新される
# CORS_ORIGINS=                # 別オリジンのフロントから API を呼ぶ場合のみ(カンマ区切り)。空なら CORS 無効
# AUDIO_CACHE_MAX_FILES=500     # 音声キャッシュ(wav)の上限。超えたら最後に使われたのが古いものから消す
