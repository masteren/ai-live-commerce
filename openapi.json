  "components": {
    "schemas": {
      "AuthIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 20,
            "minLength": 2,
            "pattern": "^[\\w\\-ぁ-んァ-ヶ一-龠ー]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 6,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "AuthIn"
      },
      "BotToggle": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "BotToggle"
      },
      "CartAdd": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "product_id"
        ],
        "title": "CartAdd"
      },
      "CartItemOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "product": {
            "$ref": "#/components/schemas/ProductOut"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "id",
          "product",
          "quantity"
        ],
        "title": "CartItemOut"
      },
      "CheckoutIn": {
        "properties": {
          "payment_method": {
            "type": "string",
            "title": "Payment Method",
            "default": "credit_card"
          }
        },
        "type": "object",
        "title": "CheckoutIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderItemOut": {
        "properties": {
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "unit_price": {
            "type": "integer",
            "title": "Unit Price"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_name",
          "unit_price",
          "quantity"
        ],
        "title": "OrderItemOut"
      },
      "OrderOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nickname": {
            "type": "string",
            "title": "Nickname"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "payment_method": {
            "type": "string",
            "title": "Payment Method"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nickname",
          "total",
          "payment_method",
          "status",
          "created_at",
          "items"
        ],
        "title": "OrderOut"
      },
      "ProductCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "emoji": {
            "type": "string",
            "maxLength": 8,
            "title": "Emoji",
            "default": "🛍️"
          },
          "price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Price"
          },
          "original_price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Original Price",
            "default": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock",
            "default": 0
          },
          "tag": {
            "type": "string",
            "title": "Tag",
            "default": ""
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "price"
        ],
        "title": "ProductCreate"
      },
      "ProductOut": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "emoji": {
            "type": "string",
            "maxLength": 8,
            "title": "Emoji",
            "default": "🛍️"
          },
          "price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Price"
          },
          "original_price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Original Price",
            "default": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock",
            "default": 0
          },
          "tag": {
            "type": "string",
            "title": "Tag",
            "default": ""
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true
          },
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "name",
          "price",
          "id"
        ],
        "title": "ProductOut"
      },
      "ProductUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
